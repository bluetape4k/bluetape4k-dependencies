{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bluetape4k/bluetape4k-dependencies/blob/develop/config/supply-chain-report.schema.json",
  "title": "Bluetape report-only supply-chain evidence",
  "description": "정식 release gate로 승격하기 전 공급망 증거를 공통 envelope로 정규화한다.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema-version",
    "report-only",
    "train",
    "repository",
    "generated-at",
    "records"
  ],
  "properties": {
    "schema-version": {
      "const": 1
    },
    "report-only": {
      "const": true
    },
    "train": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]+$"
    },
    "generated-at": {
      "type": "string",
      "format": "date-time"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/record"
      }
    }
  },
  "$defs": {
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "ecosystem",
        "status",
        "severity",
        "affected",
        "reachable",
        "exception-id",
        "exception-expiry",
        "evidence-url",
        "owner",
        "source",
        "summary"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]+$"
        },
        "ecosystem": {
          "enum": [
            "kotlin-gradle",
            "go",
            "python",
            "rust",
            "publication",
            "sbom-provenance"
          ]
        },
        "status": {
          "enum": ["pass", "review", "not-applicable", "blocked"]
        },
        "severity": {
          "enum": ["none", "low", "moderate", "high", "critical"]
        },
        "affected": {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact", "module"],
          "properties": {
            "artifact": {
              "type": "string",
              "minLength": 1
            },
            "module": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "reachable": {
          "enum": ["yes", "no", "unknown", "not-applicable"]
        },
        "exception-id": {
          "type": ["string", "null"],
          "pattern": "^[A-Z0-9][A-Z0-9-]+$"
        },
        "exception-expiry": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "evidence-url": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        },
        "owner": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "command", "path"],
          "properties": {
            "tool": {
              "type": "string",
              "minLength": 1
            },
            "command": {
              "type": "string",
              "minLength": 1
            },
            "path": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
